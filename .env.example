# Copy this file to .env and adjust it to your machine. Paths are relative to the
# project root, where every command is run from.

# The language model, a GGUF file (download link in the README).
RAG_MODEL=models/Qwen3.5-4B-Q4_K_M.gguf

# The llama.cpp server binary: a path, or just "llama-server" if it is on PATH.
LLAMA_SERVER=llama-server

# A llama-server that is already running, e.g. http://127.0.0.1:8080. When set, the app
# connects to it instead of starting its own (docker-compose.yml sets this for you).
RAG_LLM_URL=

# CPU threads for llama-server, for writing the answer and for reading the prompt.
# Leave empty to let llama.cpp decide. On a CPU with performance and efficiency cores,
# writing is fastest on the performance cores alone, reading on all of them.
LLAMA_THREADS=
LLAMA_THREADS_BATCH=

# Documents, indexes and evaluation files.
RAG_DATA=data

# Address of the web app. Use 0.0.0.0 to make it reachable from other machines
# (there is no authentication).
RAG_HOST=127.0.0.1
RAG_PORT=8000

# Set to 1 after the first run, once the embedding and reranking models are
# downloaded, to start without contacting Hugging Face.
HF_HUB_OFFLINE=0

# The embedding model. Changing it requires rebuilding the index.
# EMBEDDING_MODEL=intfloat/multilingual-e5-base
